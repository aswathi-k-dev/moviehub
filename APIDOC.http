# api call for creating an user
###
POST http://127.0.0.1:8000/films/register/ 
Content-Type: application/json

{
    "username":"user1",
    "email":"user1@gmail.com",
    "password":"Password@123"

}

#api call for token generation
###
POST http://127.0.0.1:8000/films/token/ 
Content-Type: application/json

{
    "username":"user1",
    "password":"Password@123"
}

#==== movie endpoints =====

#api call for list movies
###
GET http://127.0.0.1:8000/films/movies/ 
Accept: application/json
Authorization: Token 4eae96fd2c08567fc1bde3464de22c887ad99a41

# api call for adding movies
###
POST http://127.0.0.1:8000/films/movies/create/ 
Content-Type: application/json
Authorization: Token 4eae96fd2c08567fc1bde3464de22c887ad99a41

{
    "title": "Leo",
    "language": "Tamil",
    "genre": "ACTION",
    "actor": "Vijay",
    "release_year": 2023,
    "rating": 7.4
}

#==== song endpoints =====

# api call for create songs
###
POST http://127.0.0.1:8000/music/movies/2/song/ 
Content-Type: application/json
Authorization: Token 4eae96fd2c08567fc1bde3464de22c887ad99a41

{
    "title": "Thudakkam Mangalyam",
    "language": "Malayalam",
    "genre": "FOLK",
    "singer": "Vijay Yesudas",
    "duration": 3.42
}

#api call for retrieve
###
GET http://127.0.0.1:8000/music/movies/song/2/ 
Accept: application/json
Authorization: Token 4eae96fd2c08567fc1bde3464de22c887ad99a41

# api call for update
###
PUT http://127.0.0.1:8000/music/movies/song/1/ 
Content-Type: application/json
Authorization: Token 4eae96fd2c08567fc1bde3464de22c887ad99a41

{
  "id": 2,
  "title": "Mini Maharani",
  "language": "Malayalam",
  "genre": "ROMANTIC",
  "singer": "Vishnu vijay",
  "duration": 4.05,
  "track_number": 3,
  "created_at": "2026-10-27T15:53:56.519677Z",
  "movie": 1,
  "created_by": 1
}
  

#==== review endpoints ====

